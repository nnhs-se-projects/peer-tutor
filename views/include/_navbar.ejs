<!-- Unified Navigation Bar — role-aware, currentPage-aware -->
<%
  // ----- role → page mapping -----
  // Each entry: { key (currentPage value), label, href, icon }
  const adminPages = [
    { key: 'adminHome',          label: 'Admin Home',      href: '/adminHome',          icon: '⭐' },
    { key: 'adminUsers',         label: 'User Roles',      href: '/admin/users',        icon: '👥' },
    { key: 'adminTutorRequests', label: 'Tutor Requests',  href: '/admin/tutorRequests', icon: '📩' },
    { key: 'adminAttendance',    label: 'Attendance',      href: '/adminAttendance',    icon: '📊' },
    { key: 'sessionTable',       label: 'Session Table',   href: '/sessionTable',       icon: '🗂️' },
    { key: 'tutorTable',         label: 'Tutor Table',     href: '/tutorTable',         icon: '📋' },
    { key: 'homepage',           label: 'Leaderboard',     href: '/',                   icon: '🏅' },
  ];

  const teacherPages = [
    { key: 'teachHome',    label: 'Teacher Home',  href: '/teachHome',    icon: '🍎' },
    { key: 'tutorTable',   label: 'Tutor Table',   href: '/tutorTable',   icon: '📋' },
    { key: 'sessionTable', label: 'Session Table', href: '/sessionTable', icon: '🗂️' },
    { key: 'homepage',     label: 'Leaderboard',   href: '/',             icon: '🏅' },
  ];

  const leadPages = [
    { key: 'leadHome', label: 'Lead Home',    href: '/leadHome', icon: '🏆' },
    { key: 'tutHome',  label: 'Tutor Home',   href: '/tutHome',  icon: '📚' },
    { key: 'stuHome',  label: 'Student Home',  href: '/stuHome',  icon: '✏️' },
    { key: 'homepage', label: 'Leaderboard',   href: '/',         icon: '🏅' },
  ];

  const tutorPages = [
    { key: 'tutHome', label: 'Tutor Home',   href: '/tutHome', icon: '📚' },
    { key: 'stuHome', label: 'Student Home',  href: '/stuHome', icon: '✏️' },
  ];

  const studentPages = [
    { key: 'stuHome', label: 'Student Home', href: '/stuHome', icon: '✏️' },
  ];

  // Developer sees everything an admin sees
  const rolePagesMap = {
    developer: adminPages,
    admin:     adminPages,
    teacher:   teacherPages,
    lead:      leadPages,
    tutor:     tutorPages,
    student:   studentPages,
  };

  const role = (user && user.role) ? user.role : 'student';
  const pages = rolePagesMap[role] || studentPages;
  const cp = (typeof currentPage !== 'undefined') ? currentPage : '';

  // ----- View As -----
  const realRole = (user && user.realRole) ? user.realRole : role;
  const isViewingAs = role !== realRole;
  const viewAsOptions = (user && user.viewAsRoles ? user.viewAsRoles : []).filter(name => name !== role);
  const roleLabel = name => name.charAt(0).toUpperCase() + name.slice(1);
  // The first page listed for a role is its home
  const roleHome = name => (rolePagesMap[name] || studentPages)[0];
%>
<nav class="bg-orange-500 shadow-lg rounded-lg mb-6">
  <div class="container mx-auto px-4 py-3">
    <div class="flex justify-between items-center">
      <!-- View As role switcher (left) -->
      <div class="flex items-center">
        <% if (isViewingAs || viewAsOptions.length) { %>
        <div class="relative" id="viewAsSwitcher">
          <button 
            id="viewAsBtn"
            class="flex items-center gap-1 px-2 py-1 bg-purple-700 hover:bg-purple-800 rounded text-xs font-medium text-white transition-colors"
            onclick="toggleViewAsMenu()"
          >
            🛠️ <%= isViewingAs ? 'Viewing as ' + roleLabel(role) : 'View As' %>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div 
            id="viewAsMenu"
            class="hidden absolute left-0 top-full mt-1 bg-white rounded-lg shadow-xl border border-gray-200 py-1 z-50 min-w-32"
          >
            <% if (isViewingAs) { %>
            <button onclick="setViewAs(null, '<%= roleHome(realRole).href %>')" class="block w-full text-left whitespace-nowrap px-3 py-2 text-gray-700 hover:bg-purple-100 text-sm">↩️ Back to <%= roleLabel(realRole) %></button>
            <% if (viewAsOptions.length) { %>
            <hr class="my-1 border-gray-200">
            <% } %>
            <% } %>
            <% viewAsOptions.forEach(function(name) { %>
            <button onclick="setViewAs('<%= name %>', '<%= roleHome(name).href %>')" class="block w-full text-left whitespace-nowrap px-3 py-2 text-gray-700 hover:bg-purple-100 text-sm"><%= roleHome(name).icon %> <%= roleLabel(name) %></button>
            <% }); %>
          </div>
        </div>
        <script>
          function toggleViewAsMenu() {
            document.getElementById('viewAsMenu').classList.toggle('hidden');
          }
          async function setViewAs(role, home) {
            try {
              const response = await fetch('/api/view-as', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ role })
              });

              const data = await response.json();

              if (data.success) {
                window.location.href = home;
              } else {
                alert('Error: ' + (data.error || 'Failed to switch roles'));
              }
            } catch (error) {
              console.error('Error switching roles:', error);
              alert('Error switching roles. Please try again.');
            }
          }
          document.addEventListener('click', function(e) {
            const switcher = document.getElementById('viewAsSwitcher');
            if (switcher && !switcher.contains(e.target)) {
              document.getElementById('viewAsMenu').classList.add('hidden');
            }
          });
        </script>
        <% } %>
      </div>

      <!-- Navigation links (center) -->
      <div class="hidden md:flex items-center space-x-6">
        <% pages.forEach(function(page) { %>
          <% if (page.key !== cp) { %>
          <a
            href="<%= page.href %>"
            class="flex items-center gap-2 px-4 py-2 text-white font-medium rounded-lg hover:bg-white/90 hover:text-orange-500 hover:shadow-md transform hover:scale-105 transition-all duration-200 ease-in-out group"
          >
            <span class="text-xl group-hover:scale-110 transition-transform"><%= page.icon %></span>
            <span class="relative after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 group-hover:after:w-full after:bg-orange-500 after:transition-all"><%= page.label %></span>
          </a>
          <% } %>
        <% }); %>
      </div>
      
      <!-- Mobile hamburger (right on small screens) -->
      <div class="flex items-center gap-2">
        <button id="mobileMenuBtn" class="md:hidden p-2 rounded-lg text-white hover:bg-white/10" aria-expanded="false" aria-controls="mobileMenu" onclick="toggleMobileMenu()">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Logout (desktop) -->
        <div class="hidden md:block">
          <a href="/auth/logout" class="flex items-center gap-2 px-4 py-2 text-white font-medium rounded-lg hover:bg-red-600 hover:shadow-md transform hover:scale-105 transition-all duration-200 ease-in-out">
            <span>Logout</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile menu (shown on small screens) -->
<div id="mobileMenu" class="md:hidden hidden px-4">
  <div class="bg-orange-500 rounded-b-lg shadow-inner p-3 space-y-2">
    <% if (user && user.role === 'developer') { %>
    <div>
      <div class="text-white text-sm font-medium mb-2">Developer View</div>
    </div>
    <% } %>
    <% pages.forEach(function(page) { %>
      <% if (page.key !== cp) { %>
      <a href="<%= page.href %>" class="block px-3 py-2 rounded text-white hover:bg-white/90 hover:text-orange-500"><%= page.icon %> <span class="ml-2"><%= page.label %></span></a>
      <% } %>
    <% }); %>
    <a href="/auth/logout" class="block px-3 py-2 rounded text-white hover:bg-red-600">Logout</a>
  </div>
</div>

<script>
  function toggleMobileMenu() {
    const m = document.getElementById('mobileMenu');
    const btn = document.getElementById('mobileMenuBtn');
    if (!m) return;
    m.classList.toggle('hidden');
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
  }
  document.addEventListener('click', function(e) {
    const m = document.getElementById('mobileMenu');
    const btn = document.getElementById('mobileMenuBtn');
    if (!m || !btn) return;
    const menuArea = m;
    if (!menuArea.contains(e.target) && !btn.contains(e.target)) {
      m.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }
  });
</script>
