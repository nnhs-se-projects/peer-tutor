{
  "name": "peer-tutor",
  "version": "1.0.0",
  "description": "NNHS peer tutoring site: tutor sign-ups, session logs, tutoring requests, and attendance",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ejs": "ejslint \"views/**/*.ejs\"",
    "format": "prettier --write \"**/*.{js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,md}\""
  },
  "keywords": [
    "peer-tutoring",
    "express",
    "mongodb"
  ],
  "author": "gcschmit",
  "license": "ISC",
  "devDependencies": {
    "ejs-lint": "^2.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "google-auth-library": "^9.4.1",
    "mongodb": "^5.9.2",
    "mongoose": "^7.4.0",
    "nodemailer": "^6.9.14"
  }
}
