{
  "root": true,
  "env": {
    "commonjs": true,
    "es2022": true,
    "node": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-unused-vars": ["warn"],
    "no-console": ["warn", { "allow": ["info", "warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["assets/js/**/*.js"],
      "env": { "browser": true, "node": false, "commonjs": false }
    },
    {
      "files": ["assets/js/**/*.js"],
      "excludedFiles": ["assets/js/common.js"],
      "globals": { "escapeHtml": "readonly", "formatDateOnly": "readonly" }
    },
    {
      "files": ["scripts/**/*.js"],
      "rules": { "no-console": "off" }
    }
  ]
}
